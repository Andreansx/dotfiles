{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "#edbf8e",
      "title": "#f5ede4"
    },
    "separator": " "
  },
  "logo": {
    //"type": "kitty",
    "source": "/home/yeendrea/.config/fastfetch/archsmallcolors.txt",
    //"height": 10,
    //"source": "arch_small",
      "padding": {
      "top": 5,
      "right": 10,
      "left": 10
    },
    "color": {
        "1": "#3A2A24",
        "2": "#573B34",
        "3": "#6E4D43",
        "4": "#855F51",
        "5": "#E0A88B",
        "6": "#FADDC1",
        "7": "#e31e49"  //"#e31e49"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "",
      "outputColor": "#b08d72"
    },
    {
      "type": "title",
      //"key": "   󰌽    ",
      "key": "        ",
      "format": "{#1}スティクス",
      "outputColor": "#f2e6dc"
    },
    {
      "type": "custom",
      "format": "",
      "outputColor": "#b08d72"
    },
    {
      "type": "os",
      "key": "   󰣇    ",
      "format": "{#1}{2}",
      "outputColor": "#e31e49"
    },
    {
      "type": "kernel",
      "key": "        ",
      "outputColor": "#d4b296"
    },
    {
      "type": "custom",
      "format": "",
      "outputColor": "#b08d72"
    },
    {
      "type": "host",
      "key": "   󰌢    ",
      "format": "{family}",
      "outputColor": "#d4b296"
    },
    {
      "type": "cpu",
      "key": "        ",
      "format": "{1}",
      "outputColor": "#d4b296"
    },
    {
      "type": "memory",
      "key": "        ",
      "outputColor": "#d4b296"
    },
    {
      "type": "disk",
      "key": "   󰋊    ",
      "folders": "/",
      "format": "{1} / {2} ({9})",
      "outputColor": "#d4b296"
    },
    {
      "type": "custom",
      "format": "",
      "outputColor": "#b08d72"
    },
     {
      "type": "wm",
      "key": "   󰖲    ",
      "outputColor": "#d4a574"
    },
    {
      "type": "wmtheme",
      "key": "   󰉼    ",
      "outputColor": "#d4a574"
    },
    {
      "type": "terminal",
      "key": "        ",
      "outputColor": "#d4a574"
    },
    {
      "type": "shell",
      "key": "   󰞷    ",
      "outputColor": "#d4a574"
    },
    {
      "type": "custom",
      "format": "",
      "outputColor": "#b08d72"
    },
    {
      "type": "custom",
      "format": "",
      "outputColor": "#b08d72"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 12
    }
  ]
}
