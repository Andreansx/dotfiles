{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "#A19882",
      "title": "#EFEBE0" 
    },
    "separator": " "
  },
  "logo": {
    "source": "/home/yeendrea/.config/fastfetch/archsmallcolors.txt",
    "padding": {
      "top": 5,
      "right": 10,
      "left": 10
    },
    
    "color": {
        "1": "#5A554A",
        "2": "#6B6454",
        "3": "#867D6B",
        "4": "#A19882",
        "5": "#BDB5A2",
        "6": "#EFEBE0",
        "7": "#A19882" 
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "key": "        ",
      "format": "{#1}スティクス",
      "outputColor": "#EFEBE0"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "os",
      "key": "   󰣇    ",
      "format": "{#1}{2}",
      "outputColor": "#A19882"
    },
    {
      "type": "kernel",
      "key": "        ",
      "outputColor": "#BDB5A2" 
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "host",
      "key": "   󰌢    ",
      "format": "{family}",
      "outputColor": "#BDB5A2"
    },
    {
      "type": "cpu",
      "key": "        ",
      "format": "{1}",
      "outputColor": "#BDB5A2"
    },
    {
      "type": "memory",
      "key": "        ",
      "outputColor": "#BDB5A2"
    },
    {
      "type": "disk",
      "key": "   󰋊    ",
      "folders": "/",
      "format": "{1} / {2} ({9})",
      "outputColor": "#BDB5A2"
    },
    {
      "type": "custom",
      "format": ""
    },
     {
      "type": "wm",
      "key": "   󰖲    ",
      "outputColor": "#BDB5A2"
    },
    {
      "type": "wmtheme",
      "key": "   󰉼    ",
      "outputColor": "#BDB5A2"
    },
    {
      "type": "terminal",
      "key": "        ",
      "outputColor": "#BDB5A2"
    },
    {
      "type": "shell",
      "key": "   󰞷    ",
      "outputColor": "#BDB5A2"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 12
    }
  ]
}
