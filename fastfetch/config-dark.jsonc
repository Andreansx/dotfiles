{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "#8396CD",
      "title": "#D8D1E0"
    },
    "separator": " "
  },
  "logo": {
    "source": "/home/yeendrea/.config/fastfetch/archsmallcolors.txt",
    "padding": {
      "top": 5,
      "right": 10,
      "left": 10
    },
    "color": {
      "1": "#2A2226",
      "2": "#4A4147",
      "3": "#8396CD",
      "4": "#B58ECB",
      "5": "#E06B5C",
      "6": "#D9946A",
      "7": "#B58ECB"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "key": "        ",
      "format": "{#1}スティクス",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "os",
      "key": "   󰣇    ",
      "format": "{#1}{2}",
      "outputColor": "#D9946A"
    },
    {
      "type": "kernel",
      "key": "        ",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "host",
      "key": "   󰌢    ",
      "format": "{family}",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "cpu",
      "key": "        ",
      "format": "{1}",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "memory",
      "key": "        ",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "disk",
      "key": "   󰋊    ",
      "folders": "/",
      "format": "{1} / {2} ({9})",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "wm",
      "key": "   󰖲    ",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "wmtheme",
      "key": "   󰉼    ",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "terminal",
      "key": "        ",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "shell",
      "key": "   󰞷    ",
      "outputColor": "#D8D1E0"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 12
    }
  ]
}
