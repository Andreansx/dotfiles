{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
  	"color": {
		"keys": "#577bca",
		"title": "#85abff"
	},
	"separator": ""
  },
  "logo": {
  "source": "arch_small",
  	"padding": {
		"top": 2,
  		"left": 5
  	},
  	"color": {
  		"1": "#85abff",
		"2": "#85bbff"
  	}
  },
  "modules": [
    		{
	"type": "custom",
	"format": "╭──────────────────────────────────╮",
	"outputColor": "#577bca"
	},
		{
	"type": "title",
	"key": "          ",
	"format": "{6}{7}{8}"
	},
		{
        "type": "custom",
        "format": "╰──────────────────────────────────╮",
        "outputColor": "#577bca"
        },
//		{
//        "type": "custom",
//        "format": "┌──────────────────────────────────┐",
//        "outputColor": "#577bca"
//        },
    		{
	"type": "host",
	"key": "  » ",
	"outputColor": "#85abff"
    	},
		{
	"type": "de",
	"key": "  » "
	},
    		{
	"type": "wm",
	"key":	"  » "
	},
    		{
	"type": "cpu",
	"key": "  » ",
	"format": "{1} {3}"
	},
    		{
	"type": "memory",
	"key": "  » "
	},
    		{
	"type": "battery",
	"key": 	"  » "
	},
    		{
	"type": "poweradapter",
	"key": 	"  » "
	},
		{
	"type": "custom",
	"format": "╰──────────────────────────────────╯"
	},
		{
	"type": "custom",
	"format": " ",
	"outputColor": "#577bc1"
	}
  ]
}
