{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "#c8956d",
      "title": "#f2e6dc"
    },
    "separator": " "
  },
  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 2,
      "left": 4
    },
    "color": {
      "1": "#e85a8a",
      // "2": "#d4a574"
      "2": "#ED4078"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭─────────────────────────────────────╮",
      "outputColor": "#c8956d"
    },
    {
      "type": "title",
      "key": "   󰌽    ",
      "format": "{6}{7}{8}",
      "outputColor": "#f2e6dc"
    },
    {
      "type": "custom",
      "format": "├─────────────────────────────────────┤",
      "outputColor": "#c8956d"
    },
    {
      "type": "os",
      "key": "   󰣇    ",
      "outputColor": "#e85a8a"
    },
    {
      "type": "custom",
      "format": "├─────────────────────────────────────┤",
      "outputColor": "#c8956d"
    },
    {
      "type": "host",
      "key": "   󰌢    ",
      "format": "{family}",
      "outputColor": "#b8a08c"
    },
    {
      "type": "cpu",
      "key": "       ",
      "format": "{1}",
      "outputColor": "#b8a08c"
    },
    {
      "type": "memory",
      "key": "       ",
      "outputColor": "#b8a08c"
    },
    {
      "type": "custom",
      "format": "├─────────────────────────────────────┤",
      "outputColor": "#c8956d"
    },
    {
      "type": "wm",
      "key": "       ",
      "outputColor": "#d4a574"
    },
    {
      "type": "wmtheme",
      "key": "       ",
      "outputColor": "#d4a574"
    },
    {
      "type": "terminal",
      "key": "       ",
      "outputColor": "#d4a574"
    },
    {
      "type": "shell",
      "key": "       ",
      "outputColor": "#d4a574"
    },
    {
      "type": "custom",
      "format": "├─────────────────────────────────────┤",
      "outputColor": "#c8956d"
    },
    {
      "type": "battery",
      "key": "   󰁹    ",
      "outputColor": "#e85a8a"
    },
    {
      "type": "poweradapter",
      "key": "       ",
      "outputColor": "#e85a8a"
    },
    {
      "type": "localip",
      "key": "       ",
      "outputColor": "#e85a8a"
    },
    {
      "type": "custom",
      "format": "╰─────────────────────────────────────╯",
      "outputColor": "#c8956d"
    },
    {
      "type": "custom",
      "format": "",
      "outputColor": "#c8956d"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 12
    }
  ]
}
