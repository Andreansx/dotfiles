* {
    main-bg:          #1a1826;
    main-fg:          #e0e0e6;
    alt-bg:           #332e4d;
    inactive-fg:      #7b7794;
    selection:        #ff8b42;
    selection-fg:     #1a1826;
    accent:           #f0a999;

    trans-bg:         rgba(26, 24, 38, 0.85);
    trans-alt-bg:     rgba(51, 46, 77, 0.85);

    background-color: transparent;
    font:             "MesloLGM Nerd Font 10";
}

window {
    background-color: @trans-bg;
    border-radius:    24px;
    padding:          20px;
    width:            550px;
    location:         center;
    anchor:           center;
}

mainbox {
    spacing: 15px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @trans-alt-bg;
    text-color:       @main-fg;
    padding:          12px;
    border-radius:    16px;
    font:             "MesloLGM Nerd Font 12";
    children:         [ prompt, entry ];
}

prompt {
    background-color: inherit;
    text-color:       @accent;
    padding:          0px 10px 0px 0px;
}

entry {
    background-color: inherit;
    text-color:       @main-fg;
    placeholder:      "Szukaj...";
    placeholder-color: @inactive-fg;
}

listview {
    lines: 8;
    spacing: 8px;
    background-color: transparent;
    scrollbar:        false;
}

element {
    padding:          10px 15px;
    border-radius:    12px;
    text-color:       @main-fg;
}

element-icon {
    size: 1.5em;
    vertical-align: 0.5;
    padding: 0 12px 0 0;
}

element-text {
    text-color:       inherit;
    vertical-align: 0.5;
}

element.selected {
    background-color: @selection;
    text-color:       @selection-fg;
}
