{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "template": "{{ .UserName }}",
          "foreground": "#FF1493"
        },
        {
          "type": "session",
          "style": "powerline",
          "template": "@{{ .HostName }}",
          "foreground": "#FF6EB4"
        },
        {
          "type": "path",
          "style": "powerline",
          "template": " {{ .Path }} ",
          "foreground": "#FF69B4",
          "properties": {
            "home_icon": "~",
            "style": "full"
          }
        },
        {
          "type": "text",
          "style": "powerline",
          "template": "\u25ba",
          "foreground": "#FF3399"
        },
        {
          "type": "root",
          "style": "powerline",
          "template": " {{ if .Root }}#{{ else }}${{ end }} ",
          "foreground": "#FF1493"
        }
      ]
    }
  ]
}
