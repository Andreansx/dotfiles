{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
  	"color": {
		"keys": "#DA4167",
		"title": "#fcfcfc"
	},
	"separator": ""
  },
  "logo": {
  "source": "arch_small",
  	"padding": {
		"top": 2,
  		"left": 5
  	},
  	"color": {
  		"1": "#832161",
        "2": "#3D2645"
  	}
  },
  "modules": [
    		{
	"type": "custom",
	"format": "╭──────────────────────────────────╮",
	"outputColor": "#832161"
	},
		{
	"type": "title",
	"key": "           ",
	"format": "{6}{7}{8}",
    "outputColor": "#DA4167"
	},
		{
        "type": "custom",
        "format": "╰──────────────────────────────────╯",
        "outputColor": "#832161"
        },
		{
        "type": "custom",
        "format": "╭──────────────────────────────────╮",
        "outputColor": "#832161"
        },
    		{
	"type": "host",
	"key": "           ",
	"format": "{family}",
	"outputColor": "#85abff"
    	},
		{
	"type": "terminal",
	"key": "  󰆍  "
	},
    		{
	"type": "wm",
	"key":	"  ❱ "
	},
    		{
	"type": "cpu",
	"key": "  󰻠  ",
	"format": "{1} {3}"
	},
    		{
	"type": "memory",
	"key": "  ❱ "
	},
    		{
	"type": "battery",
	"key": 	"  ❱ "
	},
    		{
	"type": "poweradapter",
	"key": 	"  ❱ "
	},
		{
	"type": "custom",
	"format": "╰──────────────────────────────────╯",
	"outputColor": "#832161"
	},
		{
	"type": "custom",
	"format": " ",
	"outputColor": "#577bc1"
	}
  ]
}
