  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "key": "        ",
      //"format": "{#1}スティクス",
      "format": "{#1}Why u so pretty?",
      "outputColor": "#FF4E5E"
      //D8D 1E0
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "os",
      "key": "   󰣇    ",
      "format": "{#1}{2}",
      "outputColor": "#E05263"
    },
    {
      "type": "kernel",
      "key": "        ",
      "outputColor": "#947E9C"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "host",
      "key": "   󰌢    ",
      "format": "{family}",
      "outputColor": "#947E9C"
    },
    {
      "type": "cpu",
      "key": "        ",
      "format": "{1}",
      "outputColor": "#E05263"
    },
    {
      "type": "memory",
      "key": "        ",
      "outputColor": "#E05263"
    },
    {
      "type": "disk",
      "key": "   󰋊    ",
      "folders": "/",
      "format": "{1} / {2} ({9})",
      "outputColor": "#947E9C"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "wm",
      "key": "   󰖲    ",
      "outputColor": "#947E9C"
    },
    {
      "type": "wmtheme",
      "key": "   󰉼    ",
      "outputColor": "#947E9C"
    },
    {
      "type": "terminal",
      "key": "        ",
      "outputColor": "#947E9C"
    },
    {
      "type": "shell",
      "key": "   󰞷    ",
      "outputColor": "#947E9C"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "command",
      "key": "   󰒄    ",
      "text": "tailscale ip -4 || echo Disconnected",
      "outputColor": "#E6E3FF"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 12
    }
  ]
}
